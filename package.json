{
  "name": "personal-page",
  "private": true,
  "version": "1.2.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "eslint --config configs/eslint.config.js .",
    "preview": "vite preview",
    "update-patches": "npx npm-check-updates --target patch -u && npm install",
    "format": "prettier --config configs/.prettierrc --ignore-path configs/.prettierignore --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --config configs/.prettierrc --ignore-path configs/.prettierignore --check \"src/**/*.{ts,tsx,css,json}\"",
    "deps:clean": "knip --fix"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/geist": "^5.2.9",
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "@fortawesome/fontawesome-svg-core": "^7.2.0",
    "@fortawesome/free-brands-svg-icons": "^7.2.0",
    "@fortawesome/free-solid-svg-icons": "^7.2.0",
    "@fortawesome/react-fontawesome": "^3.3.1",
    "@grafana/faro-react": "^2.12.1",
    "@grafana/faro-web-tracing": "^2.12.1",
    "@lightgallery/react": "^3.0.0",
    "@remixicon/react": "^4.9.0",
    "@tailwindcss/vite": "^4.3.3",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.1",
    "jotai": "^2.20.3",
    "lightgallery": "^3.0.0",
    "react": "^19.2.9",
    "react-dom": "^19.2.9",
    "react-router": "^7.18.4",
    "tailwind-merge": "^3.6.0",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@eslint/js": "^10.0.1",
    "@grafana/faro-rollup-plugin": "^0.13.2",
    "@rolldown/plugin-babel": "^0.2.4",
    "@types/babel__core": "^7.20.5",
    "@types/node": "^24.13.6",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.0.5",
    "babel-plugin-react-compiler": "^1.0.0",
    "eslint": "^10.13.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.6.0",
    "knip": "^6.43.0",
    "prettier": "^3.9.10",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.59.4",
    "vite": "^8.3.5"
  },
  "allowScripts": {
    "esbuild@0.28.2": true
  },
  "msw": {
    "workerDirectory": [
      "public"
    ]
  }
}
